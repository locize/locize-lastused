{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "jsx": "react",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "paths": { "locize-lastused": ["./index.d.mts"] },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["./index.d.mts", "./test/**/*"],
  "exclude": []
}
